    "// 주소: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// Address: %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 주소: %@"
          }
        }
      }
    },
    "// 직접 연결도 가능하지만, 지금은 이중 포인터를 연습해봐요 — 이미 있는 포인터(%@)를 가리켜보세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// A direct connection works too, but let's practice double pointers — try pointing at the existing pointer(%@) instead."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 직접 연결도 가능하지만, 지금은 이중 포인터를 연습해봐요 — 이미 있는 포인터(%@)를 가리켜보세요."
          }
        }
      }
    },
    "// 포인터는 자기 자신을 가리킬 수 없습니다. 다른 주소를 선택해 연결하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// A pointer can't point to itself. Choose a different address to connect to."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 포인터는 자기 자신을 가리킬 수 없습니다. 다른 주소를 선택해 연결하세요."
          }
        }
      }
    },
    "// 플레이그라운드: 자유롭게 포인터를 연결해보세요. 여기선 아무것도 망가지지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// Playground: Freely connect pointers. Nothing to break here."
