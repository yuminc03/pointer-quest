    "int *%@ = &%@;" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "int *%1$@ = &%2$@;"
          }
        }
      }
    },
    "int *%@ = %@;" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "int *%1$@ = %2$@;"
          }
        }
      }
    },
    "int *%@ = %@; // %@\nint **%@ = &%@; // 이중 포인터 (이 슬롯이 %@을 가리킴)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int *%1$@ = %2$@; // %3$@\nint **%4$@ = &%5$@; // Double Pointer (This slot points to %6$@)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int *%1$@ = %2$@; // %3$@\nint **%4$@ = &%5$@; // 이중 포인터 (이 슬롯이 %6$@을 가리킴)"
          }
        }
      }
    },
    "int %@ = %lld;\nint *%@ = &%@;\n// %@ 자신도 메모리(%@)에 저장된 값(주소)입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld;\nint *%3$@ = &%4$@;\n// %5$@ itself is also a value (an address) stored in memory(%6$@)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld;\nint *%3$@ = &%4$@;\n// %5$@ 자신도 메모리(%6$@)에 저장된 값(주소)입니다."
          }
        }
      }
    },
    "int %@ = %lld; // %@의 값" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld; // Value at %3$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld; // %3$@의 값"
          }
        }
      }
    },
    "int %@ = %lld; // %@의 값\nint *%@ = &%@; // %@이 %@를 가리킴\nint **%@ = &%@; // 이중 포인터 (이 슬롯이 %@을 가리킴)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld; // Value at %3$@\nint *%4$@ = &%5$@; // %6$@ points to %7$@\nint **%8$@ = &%9$@; // Double Pointer (This slot points to %10$@)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld; // %3$@의 값\nint *%4$@ = &%5$@; // %6$@이 %7$@를 가리킴\nint **%8$@ = &%9$@; // 이중 포인터 (이 슬롯이 %10$@을 가리킴)"
          }
        }
      }
    },
    "int %@ = %lld; // %@의 값\nint *%@ = &%@; // 이 슬롯(%@)이 %@을 가리킴\n// %@ 자신도 메모리(%@)에 저장된 값(주소)입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld; // Value at %3$@\nint *%4$@ = &%5$@; // This slot(%6$@) points to %7$@\n// %8$@ itself is also a value (an address) stored in memory(%9$@)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@ = %2$lld; // %3$@의 값\nint *%4$@ = &%5$@; // 이 슬롯(%6$@)이 %7$@을 가리킴\n// %8$@ 자신도 메모리(%9$@)에 저장된 값(주소)입니다."
          }
        }
      }
    },
    "int %@; // %@의 변수가 초기화되지 않음\nint *%@ = &%@;\n// 경고: '%@'를 역참조하면 쓰레기 값이 반환됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@; // Variable at %2$@ is uninitialized\nint *%3$@ = &%4$@;\n// Warning: Dereferencing '%5$@' yields garbage value."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int %1$@; // %2$@의 변수가 초기화되지 않음\nint *%3$@ = &%4$@;\n// 경고: '%5$@'를 역참조하면 쓰레기 값이 반환됩니다."
          }
        }
      }
    },
