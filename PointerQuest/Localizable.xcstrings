    "// 레슨 1: 포인터를 드래그해서 0x700C 주소를 가리키세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// Lesson 1: Drag the pointer to point to address 0x700C."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 레슨 1: 포인터를 드래그해서 0x700C 주소를 가리키세요."
          }
        }
      }
    },
    "// 레슨 2: 0x701C를 직접 가리켜도 되지만, 이미 있는 포인터(0x7014)를 가리켜 이중 포인터를 만들어보세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// Lesson 2: You can point directly at 0x701C, but try pointing at the existing pointer(0x7014) instead to create a double pointer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 레슨 2: 0x701C를 직접 가리켜도 되지만, 이미 있는 포인터(0x7014)를 가리켜 이중 포인터를 만들어보세요."
          }
        }
      }
    },
    "// 레슨 3: Start(0x7000)에서 Treasure(0x703C)까지 체인을 만드세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// Lesson 3: Create a chain from Start(0x7000) to Treasure(0x703C)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 레슨 3: Start(0x7000)에서 Treasure(0x703C)까지 체인을 만드세요."
          }
        }
      }
    },
