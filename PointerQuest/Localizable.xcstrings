          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 다른 블록 가까이로 드래그하세요."
          }
        }
      }
    },
    "3. 손가락을 떼면 두 블록이 연결됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
