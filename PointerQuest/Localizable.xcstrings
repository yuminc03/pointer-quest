        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 레슨 1: 포인터를 드래그해서 0x700C 주소를 가리키세요."
          }
        }
      }
    },
    "// 레슨 2: 데이터(0x701C)가 잠겨 있습니다. 직접 접근하지 말고 '이중 포인터'를 사용하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// Lesson 2: Data(0x701C) is locked. Do not access directly, use 'Double Pointer'."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 레슨 2: 데이터(0x701C)가 잠겨 있습니다. 직접 접근하지 말고 '이중 포인터'를 사용하세요."
          }
        }
      }
    },
