    "int *p = %@;" : {

    },
    "int *ptr1 = %@; // %@\nint **ptr2 = &ptr1; // 이중 포인터 (이 슬롯이 ptr1을 가리킴)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int *ptr1 = %@; // %@\nint **ptr2 = &ptr1; // Double Pointer (This slot points to ptr1)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int *ptr1 = %@; // %@\nint **ptr2 = &ptr1; // 이중 포인터 (이 슬롯이 ptr1을 가리킴)"
          }
        }
      }
    },
    "int target = %lld;\nint *p = &target;" : {

    },
    "int target = %lld; // %@의 값\nint *p = &target; // 이 슬롯(%@)이 target을 가리킴" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int target = %lld; // Value at %@\nint *p = &target; // This slot(%@) points to target"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int target = %lld; // %@의 값\nint *p = &target; // 이 슬롯(%@)이 target을 가리킴"
          }
        }
      }
    },
    "int unknown; // %@의 변수가 초기화되지 않음\nint *p = &unknown;\n// 경고: 'p'를 역참조하면 쓰레기 값이 반환됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int unknown; // Variable at %@ is uninitialized\nint *p = &unknown;\n// Warning: Dereferencing 'p' yields garbage value."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int unknown; // %@의 변수가 초기화되지 않음\nint *p = &unknown;\n// 경고: 'p'를 역참조하면 쓰레기 값이 반환됩니다."
          }
        }
      }
    },
    "int val = %lld; // %@의 값" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int val = %lld; // Value at %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int val = %lld; // %@의 값"
          }
        }
      }
    },
    "int value = %lld; // %@의 값\nint *ptr1 = &value; // ptr1이 value를 가리킴\nint **ptr2 = &ptr1; // 이중 포인터 (이 슬롯이 ptr1을 가리킴)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int value = %lld; // Value at %@\nint *ptr1 = &value; // Ptr1 points to value\nint **ptr2 = &ptr1; // Double Pointer (This slot points to ptr1)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "int value = %lld; // %@의 값\nint *ptr1 = &value; // ptr1이 value를 가리킴\nint **ptr2 = &ptr1; // 이중 포인터 (이 슬롯이 ptr1을 가리킴)"
          }
        }
      }
    },
