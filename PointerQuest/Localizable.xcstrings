        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "// 플레이그라운드: 자유롭게 포인터를 연결해보세요. 여기선 아무것도 망가지지 않아요."
          }
        }
      }
    },
    "%lld" : {

